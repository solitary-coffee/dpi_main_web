{
  "name": "main-dpi",
  "compatibility_date": "2025-05-06",
  "main": "./worker/index.js",
  "keep_vars": true,
  "triggers": {
    "crons": ["0 3 * * *", "0 15 * * *"]
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "ratelimits": [
    {
      "name": "SUPPORTER_RATE_LIMITER",
      "namespace_id": "2026112501",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "ACCESS_LOG_RATE_LIMITER",
      "namespace_id": "2026112502",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "OAUTH_START_RATE_LIMITER",
      "namespace_id": "2026112503",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "kv_namespaces": [
    {
      "binding": "DPI_MAINTENANCE_KV",
      "id": "2dbad207714d49a5b03f9fc4ceb7b293"
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMAGE_CDN_META",
      "bucket_name": "dpi-image-cdn-meta"
    }
  ],

  "send_email": [
    {
      "name": "CONTACT_EMAIL"
    },
    {
      "name": "NOTICE_EMAIL",
      "allowed_sender_addresses": ["notice@dpi-bot.com"]
    }
  ],

  "d1_databases": [
    {
      "binding": "NEWSLETTER_DB",
      "database_name": "dpi-newsletter",
      "database_id": "8c0bbd9c-e3ac-4298-baa4-e98439882d3b",
      "migrations_dir": "migrations"
    },
    {
      "binding": "IP_BLOCK_DB",
      "database_name": "dpi-newsletter",
      "database_id": "8c0bbd9c-e3ac-4298-baa4-e98439882d3b",
      "migrations_dir": "migrations"
    },
    {
      "binding": "REUSE_DB",
      "database_name": "dpi-newsletter",
      "database_id": "8c0bbd9c-e3ac-4298-baa4-e98439882d3b",
      "migrations_dir": "migrations"
    },
    {
      "binding": "ACCESS_LOG_DB",
      "database_name": "dpi-newsletter",
      "database_id": "8c0bbd9c-e3ac-4298-baa4-e98439882d3b",
      "migrations_dir": "migrations"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "NEWSLETTER_QUEUE",
        "queue": "dpi-newsletter-delivery"
      }
    ],
    "consumers": [
      {
        "queue": "dpi-newsletter-delivery",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "dpi-newsletter-delivery-dlq",
        "max_concurrency": 1,
        "retry_delay": 60
      }
    ]
  },

  "vars": {
    "CONTACT_FROM_EMAIL": "noreply@dpi-bot.com",
    "RECAPTCHA_ALLOWED_HOSTS": "dpi-bot.com,www.dpi-bot.com",
    "NOTICE_FROM_EMAIL": "notice@dpi-bot.com",
    "NOTICE_REPLY_TO_EMAIL": "support@dpi-bot.com",
    "NEWSLETTER_PUBLIC_ORIGIN": "https://dpi-bot.com",
    "REUSE_PUBLIC_ORIGIN": "https://dpi-bot.com",
    "SUPPORTER_PUBLIC_ORIGIN": "https://dpi-bot.com",
    "SUPPORTER_BILLING_MODE": "live",
    "SUPPORTER_PREVIEW_OPEN": "false",
    "SUPPORTER_REVIEW_ENABLED": "false",
    "SUPPORTER_PUBLIC_ENABLED": "true",
    "SUPPORTER_INTAKE_PAUSED": "false",
    "SUPPORTER_PREVIEW_OPENED_AT": "2026-11-19T04:42:55Z",
    "SUPPORTER_SUBSCRIBER_LIMIT": "30",
    "SUPPORTER_CONSENT_VERSION": "2026-11-25",
    "SUPPORTER_IMAGE_RULES_ENABLED": "1",
    "SUPPORTER_IMAGE_RULES_V2_ENABLED": "1",
    "SUPPORTER_ROLE_GUILD_ID": "1020702614645637231",
    "SUPPORTER_ROLE_MEMBER": "1575053346904080424",
    "SUPPORTER_ROLE_BASIC": "1575053348586131528",
    "SUPPORTER_ROLE_PLUS": "1575053350016385075",
    "SUPPORTER_ROLE_PRO": "1575053351198920704",
    "SUPPORTER_ROLE_CUSTOM": "1575058113663475722",
    "STRIPE_PRICE_SUPPORTER": "price_1UdNZiPALHnKyqYsJhmArumU",
    "STRIPE_PRICE_PLUS": "price_1UdNZiPALHnKyqYsJq6JHdMN",
    "STRIPE_PRICE_PRO": "price_1UdNZjPALHnKyqYsfQgjwaKi",
    "STRIPE_PRICE_ADDON": "price_1UdNZjPALHnKyqYseeh1Qyux",
    "STRIPE_PORTAL_CONFIG": "bpc_1UdNZjPALHnKyqYsMxxZxvXl",
    "STRIPE_LIVE_PRICE_SUPPORTER": "price_1UfZdGAsIJGy08PC75FjOtTo",
    "STRIPE_LIVE_PRICE_PLUS": "price_1UfZdGAsIJGy08PCPTSsXLjG",
    "STRIPE_LIVE_PRICE_PRO": "price_1UfZdHAsIJGy08PCXhnmuwAs",
    "STRIPE_LIVE_PRICE_ADDON": "price_1UfZdHAsIJGy08PC0sfv8mFI",
    "STRIPE_LIVE_PORTAL_CONFIG": "bpc_1UfZdHAsIJGy08PCOMjBCQqJ",
    "DISCORD_CLIENT_ID": "943752169029505114",
    "DISCORD_REDIRECT_URI": "https://dpi-bot.com/api/reuse/oauth/callback",
    "SURVEY_UUID_ENTRY_ID": "266196952",
    "SURVEY_TOKEN_ENTRY_ID": "1806004575",
    "NEWSLETTER_CONSENT_VERSION": "2026-08-29",
    "STATUSPAGE_PAGE_ID": "28grbz2c7xtm",
    "STATUSPAGE_PUBLIC_URL": "https://coffeebousai.statuspage.io/"
  },

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}

