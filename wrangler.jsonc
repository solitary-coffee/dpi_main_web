{
  "name": "main-dpi",
  "compatibility_date": "2025-05-06",
  "main": "./worker/index.js",
  "keep_vars": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "kv_namespaces": [
    {
      "binding": "DPI_MAINTENANCE_KV",
      "id": "2dbad207714d49a5b03f9fc4ceb7b293"
    }
  ],

  "send_email": [
    {
      "name": "CONTACT_EMAIL"
    },
    {
      "name": "NOTICE_EMAIL",
      "allowed_sender_addresses": ["notice@dpi-bot.com"]
    }
  ],

  "d1_databases": [
    {
      "binding": "NEWSLETTER_DB",
      "database_name": "dpi-newsletter",
      "database_id": "8c0bbd9c-e3ac-4298-baa4-e98439882d3b",
      "migrations_dir": "migrations"
    },
    {
      "binding": "IP_BLOCK_DB",
      "database_name": "dpi-newsletter",
      "database_id": "8c0bbd9c-e3ac-4298-baa4-e98439882d3b",
      "migrations_dir": "migrations"
    },
    {
      "binding": "REUSE_DB",
      "database_name": "dpi-newsletter",
      "database_id": "8c0bbd9c-e3ac-4298-baa4-e98439882d3b",
      "migrations_dir": "migrations"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "NEWSLETTER_QUEUE",
        "queue": "dpi-newsletter-delivery"
      }
    ],
    "consumers": [
      {
        "queue": "dpi-newsletter-delivery",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "dpi-newsletter-delivery-dlq",
        "max_concurrency": 1,
        "retry_delay": 60
      }
    ]
  },

  "vars": {
    "CONTACT_FROM_EMAIL": "noreply@dpi-bot.com",
    "RECAPTCHA_ALLOWED_HOSTS": "dpi-bot.com,www.dpi-bot.com",
    "NOTICE_FROM_EMAIL": "notice@dpi-bot.com",
    "NOTICE_REPLY_TO_EMAIL": "support@dpi-bot.com",
    "NEWSLETTER_PUBLIC_ORIGIN": "https://dpi-bot.com",
    "REUSE_PUBLIC_ORIGIN": "https://dpi-bot.com",
    "DISCORD_CLIENT_ID": "943752169029505114",
    "DISCORD_REDIRECT_URI": "https://dpi-bot.com/api/reuse/oauth/callback",
    "NEWSLETTER_CONSENT_VERSION": "2026-08-29",
    "STATUSPAGE_PAGE_ID": "28grbz2c7xtm",
    "STATUSPAGE_PUBLIC_URL": "https://coffeebousai.statuspage.io/"
  },

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}

